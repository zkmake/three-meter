{
  "name": "@zkmake/three-meter",
  "version": "0.0.0",
  "private": true,
  "description": "Zero-dependency three.js frame metrics (FPS, CPU, GPU, draw calls) with a dockable HUD. Vanilla three and React Three Fiber adapters.",
  "license": "MIT",
  "author": "Zubin Khavarian",
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./ui": {
      "types": "./src/ui/index.ts",
      "import": "./src/ui/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "ci:test": "vitest run",
    "ci:typecheck": "tsc",
    "test": "vitest watch",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@config/typescript": "workspace:*",
    "@react-three/fiber": "catalog:",
    "@types/react": "catalog:",
    "@types/three": "catalog:",
    "react": "catalog:",
    "three": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=8",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
